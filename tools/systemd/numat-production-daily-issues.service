[Unit]
Description=Send NuMat daily production checks email when due
After=network-online.target numat-ai.service
Wants=network-online.target

[Service]
Type=oneshot
User=numatadmin
WorkingDirectory=/srv/numat-ai/backend
EnvironmentFile=/srv/numat-ai/backend/.env
ExecStart=/srv/numat-ai/backend/venv/bin/python /srv/numat-ai/backend/production_daily_issues.py --run-if-due
